# ==============================================================================
# GOVINNOVATE ENVIRONMENT CONFIGURATION (.env.example)
# Safe placeholder template. Never commit real credentials or private keys.
# ==============================================================================

# Supabase Public Client Credentials (Required for Real Mode Auth & Live Tables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Supabase Server-Only Service Role Key (Optional: for trusted server-side admin operations)
# NEVER prefix with NEXT_PUBLIC_ or expose in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API Key (Optional: for dynamic Civic Assistant LLM chat)
# If omitted, platform seamlessly falls back to the verified heuristic civic knowledge engine.
OPENAI_API_KEY=your-openai-api-key-here

# ==============================================================================
# BLOCKCHAIN EVIDENCE INTEGRITY ENGINE CONFIGURATION
# ==============================================================================
# Execution mode: "live" (connects to Hardhat local node or testnet) or "simulated" (default fallback)
BLOCKCHAIN_MODE=simulated

# JSON-RPC Provider URL (e.g. http://127.0.0.1:8545 for local Hardhat node or https://sepolia.infura.io/v3/YOUR_KEY)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Deployed EvidenceRegistry Smart Contract Address
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Server-side authorized operator private key (NEVER prefix with NEXT_PUBLIC_ or commit to Git)
# This default key is the standard well-known Hardhat #0 account used strictly for local development.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
