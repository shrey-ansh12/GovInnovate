# ==============================================================================
# GOVINNOVATE ENVIRONMENT CONFIGURATION (.env.example)
# Safe placeholder template. Never commit real credentials or private keys.
# ==============================================================================

# Supabase Public Client Credentials (Required for Real Mode Auth & Live Tables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Supabase Server-Only Service Role Key (Optional: for trusted server-side admin operations)
# NEVER prefix with NEXT_PUBLIC_ or expose in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API Key (Optional: for dynamic Civic Assistant LLM chat)
# If omitted, platform seamlessly falls back to the verified heuristic civic knowledge engine.
OPENAI_API_KEY=your-openai-api-key-here
